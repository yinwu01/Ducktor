{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('path').resolve(process.env.CLAUDE_PLUGIN_ROOT || process.env.PLUGIN_ROOT || '.', 'bin', 'duck.js')).main('session-start')\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
